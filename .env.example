# Copy to .env.local and fill in real values. Never commit .env.local.

# Google Analytics 4 measurement ID (G-XXXXXXXXXX). Leave blank to disable tracking entirely.
NEXT_PUBLIC_GA_ID=

# Google Analytics Data API, for the admin traffic page.
# GA_PROPERTY_ID is the numeric id in GA Admin → Property details (not G-XXXX).
# GA_SERVICE_ACCOUNT_KEY is the service account JSON key on one line; that
# account must be a Viewer on the GA property.
GA_PROPERTY_ID=
GA_SERVICE_ACCOUNT_KEY=

# Public site URL (used by NextAuth for callbacks in production)
AUTH_URL=

# Generate with: npx auth secret. Also salts the rate-limit fingerprints.
AUTH_SECRET=

# Trust the platform's Host header. Set to "true" only where the host is set by
# the platform and TLS terminates there (Vercel). Absent = the safer behaviour,
# with AUTH_URL as the canonical origin.
AUTH_TRUST_HOST=

# Google OAuth client (Google Cloud → Credentials → Web application)
# Authorised redirect URIs must include:
#   https://YOUR-DOMAIN/api/auth/callback/google
#   http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# The database: the `course` schema on the Neon instance that also runs
# app.klymb.ai, so a learner here is the same person as the platform user with
# that address. Use the -pooler host: this database serves app.klymb.ai's
# users too, and the connection budget is not ours alone to spend.
#
# Connect as klymb_course, which may only read and write the course schema —
# not as the database owner. See db/migrations/0002_grants.sql.
DATABASE_URL=
# Optional, for `npm run db:migrate` only: the owner connection, which may
# create tables. Falls back to DATABASE_URL when unset.
DATABASE_MIGRATE_URL=

# Supabase — a message bus now, not a database. The only thing left using it
# is the live device-switch sign-out (src/lib/learner/device-channel.ts), and
# Realtime broadcast never touches a database, so this project holds no data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only, and only to authenticate a broadcast. It no longer reaches any
# data: every table moved to DATABASE_URL above.
SUPABASE_SERVICE_ROLE_KEY=

# Razorpay (key secret must stay server-side only)
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Email / WhatsApp notifications
EMAIL_PROVIDER_API_KEY=
WHATSAPP_API_TOKEN=

# Lesson media — Cloudflare R2. The videos are not in this repo: git keeps
# every version of an mp4 whole, so a re-encode is a permanent new blob and a
# 21-day course would be a third of a gigabyte in every clone. See
# src/lib/media.ts, and `npm run media:upload` to push media/ to the bucket.
#
# The bucket is private. /api/media authorises the request and redirects to a
# URL signed for the hour, so a lesson is never addressable on its own.
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# The bucket's public domain (custom domain, or the pub-….r2.dev one), used
# for posters only — they are thumbnails, not the product, and a redirect per
# card is a round trip for nothing. Must be an origin, no trailing slash.
NEXT_PUBLIC_MEDIA_BASE_URL=
