# Copy to .env.local and fill in real values. Never commit .env.local.
# None of these are used yet — they are placeholders for upcoming integrations.

# Public site URL (used for metadata / redirects)
NEXT_PUBLIC_SITE_URL=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Razorpay (key secret must stay server-side only)
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Email / WhatsApp notifications
EMAIL_PROVIDER_API_KEY=
WHATSAPP_API_TOKEN=
