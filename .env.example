# Copy to .env.local and fill in real values. Never commit .env.local.

# Google Analytics 4 measurement ID (G-XXXXXXXXXX). Leave blank to disable tracking entirely.
NEXT_PUBLIC_GA_ID=

# Google Analytics Data API, for the admin traffic page.
# GA_PROPERTY_ID is the numeric id in GA Admin → Property details (not G-XXXX).
# GA_SERVICE_ACCOUNT_KEY is the service account JSON key on one line; that
# account must be a Viewer on the GA property.
GA_PROPERTY_ID=
GA_SERVICE_ACCOUNT_KEY=

# Public site URL (used by NextAuth for callbacks in production)
AUTH_URL=

# Generate with: npx auth secret. Also salts the rate-limit fingerprints.
AUTH_SECRET=

# Trust the platform's Host header. Set to "true" only where the host is set by
# the platform and TLS terminates there (Vercel). Absent = the safer behaviour,
# with AUTH_URL as the canonical origin.
AUTH_TRUST_HOST=

# Google OAuth client (Google Cloud → Credentials → Web application)
# Authorised redirect URIs must include:
#   https://YOUR-DOMAIN/api/auth/callback/google
#   http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# LinkedIn one-tap posting: a learner who connects LinkedIn publishes a lesson
# or badge post (image and text) to their feed with one tap. Leave blank and the
# share buttons keep using the share sheet / prefilled post. Setup steps for the
# LinkedIn developer app are in README.md → "LinkedIn posting".
# Authorized redirect URLs on the app must include:
#   https://YOUR-DOMAIN/api/linkedin/callback
#   http://localhost:3000/api/linkedin/callback
# Tokens are sealed with a key derived from AUTH_SECRET: rotating it disconnects everyone.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Optional. LinkedIn-Version for the Posts and Images APIs (YYYYMM). Each is
# served for about a year; the default is in src/lib/linkedin/api.ts.
LINKEDIN_API_VERSION=

# The database: the `course` schema on the Neon instance that also runs
# app.klymb.ai, so a learner here is the same person as the platform user with
# that address. Use the -pooler host: this database serves app.klymb.ai's
# users too, and the connection budget is not ours alone to spend.
#
# Connect as klymb_course, which may only read and write the course schema —
# not as the database owner. See db/migrations/0002_grants.sql.
DATABASE_URL=
# For `npm run db:migrate`: the owner connection, which may create tables.
# Falls back to DATABASE_URL when unset. In Vercel it is required, in the
# Production environment only: scripts/vercel-build.sh stops without it. Use the
# direct host, not -pooler, so the migration lock holds.
DATABASE_MIGRATE_URL=

# Supabase — a message bus now, not a database. The only thing left using it
# is the live device-switch sign-out (src/lib/learner/device-channel.ts), and
# Realtime broadcast never touches a database, so this project holds no data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only, and only to authenticate a broadcast. It no longer reaches any
# data: every table moved to DATABASE_URL above.
SUPABASE_SERVICE_ROLE_KEY=

# Razorpay (key secret must stay server-side only). The key id is handed to the
# browser with each order, so there is no NEXT_PUBLIC_ copy.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Transactional email: receipts, welcomes, follow-ups, System Design reminders.
# MAIL_FROM is an address on a domain verified with whichever provider sends it
# (Brevo, and SES for anything routed to ABT-Mailer). Without a sender and one
# provider nothing is sent, and nothing else breaks.
BREVO_API_KEY=
MAIL_FROM=
MAIL_REPLY_TO=

# ABT-Mailer, the team's SES sender. Kinds listed in EMAIL_VIA_ABT_KINDS go
# through it instead of Brevo: exact names, `prefix.*` or `*`, comma-separated,
# e.g. "sd.*". EMAIL_KEEP_ON_BREVO_KINDS (same syntax) wins over it. Clear the
# list to move everything back to Brevo. The secret is ABT-Mailer's
# TRANSACTIONAL_API_HMAC_SECRET, and MAIL_FROM's domain must be verified in SES.
# Kinds: registration.welcome, registration.followup.{1,2,3}, payment.receipt,
# sd.receipt, sd.referral_earned, sd.followup.{1,2,3}, sd.invite, sd.reminder.lesson, sd.reminder.assessment,
# support.ticket
ABT_MAILER_URL=
ABT_MAILER_HMAC_SECRET=
EMAIL_VIA_ABT_KINDS=
EMAIL_KEEP_ON_BREVO_KINDS=

# Local testing only (ignored in production): every mail goes to this address
# instead of its recipient, whose address goes in the subject. Set it whenever
# DATABASE_URL points at real data.
MAIL_REDIRECT_TO=

# "true" mails everyone who pre-registered for System Design before payments
# opened, once each, from the hourly follow-up job: "it's open, your price is held".
SD_INVITE_PREREGISTERED=

# Bearer token for /api/cron/* (GitHub Actions sends it; also a repository secret).
CRON_SECRET=

# WhatsApp notifications (not wired up yet)
WHATSAPP_API_TOKEN=

# Cloudflare R2: System Design videos (bucket klymb-videos). A read-only API
# token. Paid lessons are served from R2 only; without these, Day 0 and the
# overview fall back to their copies in public/videos and paid videos won't play.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=klymb-videos

# Voice coach (/learn/coach) — OpenAI's Realtime API, speech to speech over
# WebRTC, so a spoken answer comes back without a transcribe → think → speak
# chain in the middle. Leave OPENAI_API_KEY blank and the page says the coach
# is not switched on; nothing else on the course is affected.
#
# The key never reaches the browser, and the browser is not given a
# short-lived client secret either: /api/coach/session relays the WebRTC
# offer, because the session's instructions carry the learner's name, track
# and progress. See src/lib/coach/realtime.ts.
OPENAI_API_KEY=
# Optional. The realtime model is replaced faster than we deploy, and `marin`
# and `cedar` are the voices OpenAI recommends for it.
OPENAI_REALTIME_MODEL=
OPENAI_REALTIME_VOICE=
